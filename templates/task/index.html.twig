{% extends 'base.html.twig' %}

{% block title %}Page Tâches
{% endblock %}

{% block body %}

	<div class="session_container">
		<div class="session">
			<h1>Liste des Tâches</h1>

			{% if tasks is empty%}
				<div class="txt-align margin-top30 bold font-size20">
					<p>Nous sommes désolés, vous n'avez pas de tâches reliées à votre projet.</p>
				</div>
			{% else %}
				{% for tasks in tasks %}
					<div class="txt-align margin-top30 bold font-size20">
						<p class="txt-decoration">Le nom de votre tâche est :</p>
						<p>{{ tasks.name }}</p>
					</div>
				{% endfor %}
			{% endif %}

			<p class="txt-align margin-top30 bold font-size20 txt-decoration">
				<a href=" {{ path('app_project_edit', {'id': project.id})}}">Désirez-vous modifier votre produit ???</a>
			</p>

			<p class="txt-align margin-top30 bold font-size20 txt-decoration">
				<a href=" {{ path('app_project_delete', {'id': project.id})}}">Désirez-vous supprimer votre produit ???</a>
			</p>

		</div>
	</div>

{% endblock %}
