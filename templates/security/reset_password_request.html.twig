{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du Mot de Passe
{% endblock %}

{% block body %}

	<div class="session_container">
		<div class="session">
			<h1>Réinitialisation du Mot de Passe</h1>

			<div method="post" class="form flex align-items">

				{{form_start(requestPassForm)}}

				<div class="flex mt-3">
					{{form_label(requestPassForm.email)}}
					{{form_widget(requestPassForm.email)}}
					{{form_errors(requestPassForm.email)}}
				</div>

				<button type="submit" class="btn btn-md btn-primary mt-3">Valider</button>

				{{form_end(requestPassForm)}}

			</div>
		</div>
	</div>
{% endblock %}
